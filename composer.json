{
	"name": "phpsyntax/phpsyntax",
	"description": "Lossless concrete syntax tree (CST) for PHP with a round-trip printer and a mutation API",
	"keywords": ["php", "parser", "lexer", "syntax tree", "cst", "lossless", "tokenizer", "refactoring"],
	"license": "MIT",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6",
		"ext-tokenizer": "*"
	},
	"require-dev": {
		"nette/tester": "^2.6",
		"tracy/tracy": "^2.12",
		"phpstan/phpstan": "^2.2",
		"phpstan/extension-installer": "^1.4",
		"nette/phpstan-rules": "^1.0"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"PhpSyntax\\": "src"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s",
		"build": "php grammar/build.php",
		"reference": "php docs/reference/generate.php",
		"verify-examples": "php examples/verify.php"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		}
	}
}
