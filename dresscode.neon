use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- tests

excludePaths:
	- tests/**/output
	- corpus
	- dump

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations
	-
		paths: [tests]
		file: {longLines: keep}
