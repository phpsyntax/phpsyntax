use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- grammar
	- tests
	- docs/reference/generate.php

excludePaths:
	- tests/**/output
	- corpus
	- dump

fileExtensions:
	- php
	- phpt

imports:
	grouping:
		class: grouped

functions:
	namedBooleanArgument: required

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations
